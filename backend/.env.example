# Server Configuration
PORT=5000
NODE_ENV=development
DEMO_MODE=true

# AI Triage (Anthropic Claude API)
# Required for live Claude LLM calls. If not provided, smart heuristic fallback triage is used.
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Firebase Admin SDK Configuration
# If credentials are not set, backend operates in high-fidelity in-memory Firestore mode for zero-setup demos.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=
# Optional emulator address, e.g. localhost:8080
FIRESTORE_EMULATOR_HOST=

# Twilio WhatsApp Business API
# Used for citizen reporting via WhatsApp Sandbox
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# JWT / Auth Secret (for dev token generation/fallback)
AUTH_DEV_SECRET=rakshak_child_safety_dev_secret_2026
