# Server Configuration
PORT=5000
NODE_ENV=production
DEMO_MODE=false
ALLOW_DEMO_TOKENS=true

# AI Triage (Groq)
# If unset, the deterministic child-safety heuristic fallback is used.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Firebase Admin SDK Configuration
# If credentials are not set, backend operates in high-fidelity in-memory Firestore mode for zero-setup demos.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=
# Optional emulator address, e.g. localhost:8080
FIRESTORE_EMULATOR_HOST=

# Twilio WhatsApp Business API
# Used for citizen reporting via WhatsApp Sandbox
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# JWT / Auth Secret (for dev token generation/fallback)
AUTH_DEV_SECRET=rakshak_child_safety_dev_secret_2026
